# Copy this to webapp/deploy/.env and fill it in. NEVER commit the real .env (it holds secrets).
#   cp webapp/deploy/.env.example webapp/deploy/.env && edit it

# ---- public hostname (REQUIRED) -------------------------------------------------------------------
# The domain whose A record points at this server. Caddy gets a Let's Encrypt cert for it automatically.
VF_DOMAIN=vf.example.com

# ---- password gate (REQUIRED) ---------------------------------------------------------------------
# Basic-auth username, and a BCRYPT HASH of the password (never the plaintext). Generate the hash with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'choose-a-strong-password'
# Paste the $2a$... output as VF_BASIC_HASH. (In .env, escape every literal $ as $$ so compose doesn't
# treat it as a variable -- e.g. $$2a$$14$$....)
VF_BASIC_USER=admin
VF_BASIC_HASH=REPLACE_WITH_BCRYPT_HASH

# ---- spend lanes (OPTIONAL) -----------------------------------------------------------------------
# Leave a key blank to keep that lane a FREE local fallback (GPU toggle -> CPU; AI-goal -> deterministic).
ANTHROPIC_API_KEY=
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

# ---- hard per-UTC-day spend backstop --------------------------------------------------------------
# A leaked password cannot exceed these. The app degrades honestly (CPU / deterministic) once a cap is hit.
VF_DAILY_USD_CAP=5.0
VF_MAX_GPU_RUNS_PER_DAY=100
VF_MAX_LLM_CALLS_PER_DAY=200
# unit-cost ESTIMATES used to accumulate the USD figure (deliberate over-estimates -> a ceiling, not a bill)
VF_GPU_USD_PER_RUN=0.05
VF_LLM_USD_PER_CALL=0.02
